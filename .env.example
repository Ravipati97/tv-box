# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored and never committed.

# Supabase project settings -> API Keys
# Use the "Publishable key" (sb_publishable_...) if you see one, otherwise the
# legacy "anon" "public" key (eyJ...) from the Legacy API Keys tab. Either works.
VITE_SUPABASE_URL=https://fuitioxkdagmfnvpteys.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# TMDB (themoviedb.org) -> Settings -> API -> API Key (v3 auth)
VITE_TMDB_API_KEY=your-tmdb-v3-api-key

# shared passcode required before anyone signed-out can reach the
# login screen. Pick any 6 digits. Leave unset to disable the gate entirely.
# NOT real security -- it's baked into the public JS bundle like the keys
# above -- just a soft deterrent against randoms finding the URL.
VITE_SITE_PASSCODE=123456
